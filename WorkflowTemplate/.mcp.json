{
    "mcpServers": {
      "github": {
        "type": "http",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
          "Authorization": "Bearer ${GITHUB_PAT}"
        }
      },
      "ado": {
        "type": "stdio",
        "command": "npx",
        "args": ["-y", "@azure-devops/mcp@2.9.0", "project-template", "--authentication", "pat"],
        "env": {
          "PERSONAL_ACCESS_TOKEN": "${ADO_PAT_B64}"
        }
      },
      "playwright": {
        "type": "stdio",
        "command": "npx",
        "args": ["-y", "@playwright/mcp@latest", "--browser", "chrome", "--viewport-size", "1920x1080", "--isolated"]
      }
    }
  }